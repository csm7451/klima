/* Root: fill terminal, scroll the main pane instead of shrinking/cropping content */
Screen {
    layout: vertical;
    align: left top;
}

#main-container {
    width: 100%;
    height: 1fr;
    min-height: 0;
    scrollbar-gutter: stable;
}

#main-container.main-splash {
    align: center middle;
    content-align: center middle;
}

WeatherDashboard {
    width: 100%;
    height: auto;
}

CompareDashboard {
    width: 100%;
    height: auto;
}

#dashboard-vertical {
    width: 100%;
    height: auto;
    align: left top;
    padding: 0 0 1 0;
}

Vertical.dash-root.theme-night #location-label {
    color: $text-muted;
}

Vertical.dash-root.theme-night .section-label {
    color: $secondary;
}

Vertical.compare-root.theme-night #compare-title {
    color: $text-muted;
}

#location-label {
    width: 100%;
    content-align: center middle;
    margin-top: 1;
    margin-bottom: 1;
    color: $primary;
}

/* One row: current | AQI/UV | location — favor first two columns over location */
#summary-block {
    width: 100%;
    height: auto;
    margin: 0 1 1 1;
    grid-size-columns: 3;
    grid-columns: auto 2fr 1fr;
}

#summary-block #current-section {
    width: auto;
    height: auto;
    min-width: 26;
}

#summary-block #current-static {
    width: 100%;
    height: auto;
    min-width: 0;
    content-align: left top;
}

#summary-block #aq-strip {
    width: 100%;
    min-width: 32;
    height: auto;
    padding: 1 2;
    border: heavy $secondary;
    color: $text;
    content-align: left top;
}

#summary-block #city-info {
    width: 100%;
    min-width: 18;
    height: auto;
    padding: 1 1;
    border: heavy $surface-lighten-2;
    color: $text;
}

.daily-row-compare {
    width: 100%;
    height: auto;
    align: left top;
}

.daily-row-compare .day-cell {
    height: auto;
}

.section-label {
    width: 100%;
    margin: 1 0 0 0;
    color: $secondary;
    content-align: center middle;
}

#charts-row {
    width: 100%;
    height: auto;
    min-height: 14;
    margin: 0 1 1 1;
    padding: 0;
    border: solid $primary 30%;
    overflow-x: auto;
    align: left top;
}

#charts-row .chart-column {
    width: 1fr;
    min-width: 14;
    height: auto;
    align: center middle;
}

#charts-row PlotextPlot {
    width: 100%;
    height: 14;
    min-height: 10;
}

#daily-row {
    width: 100%;
    height: auto;
    margin: 0 1 2 1;
    padding: 1;
    border: solid $primary 20%;
    overflow-x: auto;
    align: left top;
}

#daily-row .day-cell {
    width: auto;
    height: auto;
    min-width: 8;
    padding: 0 1;
    border-left: solid $primary 15%;
}

#daily-row .day-cell:first-child {
    border-left: none;
}

#compare-title {
    width: 100%;
    content-align: center middle;
    margin: 1 0;
    color: $primary;
}

#compare-row {
    width: 100%;
    height: auto;
    overflow-x: auto;
    padding: 0 1;
}

.compare-column {
    width: auto;
    min-width: 26;
    margin: 0 1;
    padding: 0 1;
    border-left: solid $primary 20%;
}

.compare-column:first-of-type {
    border-left: none;
}

.compare-heading {
    width: 100%;
    margin-bottom: 1;
}

.compare-current {
    width: 100%;
    margin-bottom: 1;
}

.compare-city {
    margin-bottom: 1;
}

LocationInputScreen {
    width: 40;
    max-width: 78;
    height: auto;
    padding: 2;
    border: solid $primary;
    align: center middle;
}

.recent-scroll {
    width: 100%;
    max-height: 14;
}

.recent-button {
    width: 100%;
    margin: 0 0 1 0;
}

.center-pad {
    padding: 2;
}

#prompt-label {
    width: 100%;
    margin-bottom: 1;
}

#location-input {
    width: 100%;
    margin-bottom: 1;
}

#hint-label {
    width: 100%;
    color: $text-muted;
}

.error-box {
    width: 100%;
    max-width: 50;
    padding: 1 2;
    border: solid $error;
    color: $error;
    margin: 1 1;
    content-align: center middle;
}
